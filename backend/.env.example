# ── Database ──────────────────────────────────────────────────────────────────
# EC2 / Docker：使用 remote DB（get_secret key=qa_database）
USE_QA_DATABASE_SECRET=true

# 本機開發改為 false 並設定 DATABASE_URL
# USE_QA_DATABASE_SECRET=false
# DATABASE_URL=sqlite+aiosqlite:///./tcms_1_5.db

# ── Secret service（get_secret 必要，與 QA-automation 相同）───────────────────
SECRET_SERVICE_URL=http://autotest-service.sit.kkday.com
AUTOMATION_TOKEN=<從 autotest-service 或 QA-automation 取得>

# ── Dify（選用）────────────────────────────────────────────────────────────────
# DIFY_BASE_URL=https://dify.example.com
# DIFY_API_KEY=
# DIFY_DATASET_ID=
