# ── Database ──────────────────────────────────────────────────────────────────
# 預設用本機 DATABASE_URL（SQLite 即裝即用）。
USE_LOCAL_DB=true
DATABASE_URL=sqlite+aiosqlite:///./tcms_1_5.db

# EC2 / Docker prod 部署：改為 false 後會從 secret service 拿 qa_database 連線。
#   USE_LOCAL_DB=false
# 需同時設定 SECRET_SERVICE_URL 與 AUTOMATION_TOKEN（見下）。

# DEPRECATED — 舊名 USE_QA_DATABASE_SECRET 仍會被讀（行為與 USE_LOCAL_DB 相反），
# 啟動時會印 DeprecationWarning，請逐步遷移到 USE_LOCAL_DB。

# ── Secret service（USE_LOCAL_DB=false 時必填，與 QA-automation 相同）─────────
SECRET_SERVICE_URL=http://autotest-service.sit.kkday.com
AUTOMATION_TOKEN=<從 autotest-service 或 QA-automation 取得>

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# 從 Google Cloud Console > APIs & Services > Credentials 取得 OAuth 2.0 Client ID。
# 部署 / docker-compose up 前必填，否則登入 callback 會失敗。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 本機: http://localhost:19425/api/v1/users/google-oauth/callback
# SIT/EC2: http://autotest-service.sit.kkday.com:8081/tcms/api/v1/users/google-oauth/callback
GOOGLE_OAUTH_REDIRECT_URI=

# ── Dify（選用）────────────────────────────────────────────────────────────────
# DIFY_BASE_URL=https://dify.example.com
# DIFY_API_KEY=
# DIFY_DATASET_ID=
